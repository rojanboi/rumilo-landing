# Settings for api/contact.js (the call-request form).
# On Vercel set them in Project → Settings → Environment Variables, then redeploy.
# For `vercel dev` copy this file to .env.local and fill it in.
# Check the result at /api/contact: it says which way is active and whether it works.

# --- Way 1: Gmail. No domain needed, letters reach every recipient. ---
# The mailbox that sends (Gmail or Google Workspace).
GMAIL_USER=
# App password for that mailbox: https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). Not the normal password.
GMAIL_APP_PASSWORD=

# --- Way 2: Resend. Used when the Gmail variables are empty, and as a second try. ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# The sender, not a recipient. Its domain has to be verified in Resend (Domains → Add domain).
# Without a verified domain Resend delivers only to the owner of the Resend account.
# CONTACT_FROM="Rumilo <rozmowa@example.com>"

# --- Both ways ---
# Optional: comma-separated recipients. Without it the list in api/contact.js is used.
# CONTACT_TO=first@example.com,second@example.com
