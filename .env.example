# Settings for api/contact.js (the "Umów rozmowę" form).
# On Vercel set them in Project → Settings → Environment Variables.
# For `vercel dev` copy this file to .env.local and fill it in.

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender. The domain has to be verified in Resend (Domains → Add domain).
# Left empty, the Resend test sender is used; it only delivers to the Resend account owner.
CONTACT_FROM="Rumilo <rozmowa@example.com>"

# Optional: comma-separated recipients. Without it the list in api/contact.js is used.
# CONTACT_TO=first@example.com,second@example.com
